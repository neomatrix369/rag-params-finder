# ── Server ────────────────────────────────────────────────────────────────────
SERVER_URL=http://localhost:8001

# ── Storage backend ───────────────────────────────────────────────────────────
# STORAGE_BACKEND selects the run-state adapter (experiments, runs, results).
# Canonical: sqlite (default) | mongodb | postgres. Legacy alias: mongo → mongodb.
# SQLite (default, ADR-008): no external service required; VECTOR_STORE_BACKEND must be set.
# STORAGE_BACKEND=sqlite

# Vector store for chunks (OPTIONAL). Defaults to STORAGE_BACKEND.
# A store that can host run state must equal STORAGE_BACKEND (pairing rule ii).
# Elasticsearch is vector-only. Install: pip install -e ".[elasticsearch]"
# Local: ./start-services.sh --elasticsearch-local
# Cloud: ./start-services.sh --elasticsearch-cloud and set ELASTICSEARCH_CLOUD_URL.
# VECTOR_STORE_BACKEND=elasticsearch
# ELASTICSEARCH_INDEX_PREFIX=rpf

# ── MongoDB — Atlas Cloud or Atlas Local Docker ───────────────────────────────
# Uncomment ONE of the two lines below. Cloud wins when both are set.
#
# Cloud (Atlas connection string from cloud.mongodb.com → Connect):
# MONGODB_ATLAS_CLOUD_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rag_params_finder?appName=<app>
#
# Local (Atlas Local Docker — after ./start-services.sh --mongodb-local):
# MONGODB_ATLAS_LOCAL_URI=mongodb://localhost:27017/rag_params_finder?directConnection=true
#
# See docs/user-guide/mongodb-setup.md

# Optional — auto-detect cluster storage quota for the dashboard (Atlas Admin API).
# Without these, set MONGODB_STORAGE_LIMIT_MB manually or quota UI stays hidden.
# ATLAS_PUBLIC_KEY=
# ATLAS_PRIVATE_KEY=
# ATLAS_GROUP_ID=                         # 24-char project ID from Atlas URL
# ATLAS_CLUSTER_NAME=                     # omit to parse from MONGODB_ATLAS_CLOUD_URI host
# MONGODB_STORAGE_LIMIT_MB=512            # manual override (MB); skips API lookup

# ── Postgres / pgvector ───────────────────────────────────────────────────────
# Uncomment ONE of the two lines below (and set STORAGE_BACKEND=postgres).
# Cloud wins when both are set.
#
# Cloud (Supabase — Session-mode pooler URI from Supabase → Settings → Database):
# POSTGRES_CLOUD_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Local (pgvector Docker — after ./start-services.sh --postgres-local):
# POSTGRES_LOCAL_URL=postgresql://rag:rag@localhost:5433/rag_params_finder
#
# STORAGE_BACKEND=postgres
# Compose service credentials (optional overrides for docker-compose.yml):
# POSTGRES_USER=rag
# POSTGRES_PASSWORD=rag
# POSTGRES_DB=rag_params_finder
#
# Prefer configs/supabase/example-unified-retrievers.yaml (16 runs) for first cloud prove.
# See docs/user-guide/postgres-setup.md

# ── Elasticsearch ─────────────────────────────────────────────────────────────
# Uncomment ONE of the two lines below (and set VECTOR_STORE_BACKEND=elasticsearch).
# Cloud wins when both are set.
#
# Cloud (hosted Elasticsearch service URL):
# ELASTICSEARCH_CLOUD_URL=https://<deployment-id>.es.<region>.aws.elastic-cloud.com:9243
#
# Local (Elasticsearch Docker — after ./start-services.sh --elasticsearch-local):
# ELASTICSEARCH_LOCAL_URL=http://localhost:9200
#
# ELASTICSEARCH_API_KEY=       # optional; cloud instances usually require this

# ── Redis 8 (vector-only; run state must stay on mongodb/postgres/sqlite) ─────
# Redis is a vector-only store. Install: pip install -e ".[redis]"
# Local: ./start-services.sh --redis-local
# Cloud: ./start-services.sh --redis-cloud and set REDIS_URL.
# VECTOR_STORE_BACKEND=redis
# REDIS_INDEX_PREFIX=rpf
#
# Local (Redis 8 Docker — after ./start-services.sh --redis-local):
# REDIS_URL=redis://127.0.0.1:6379
#
# Cloud (TLS managed Redis — rediss:// for TLS):
# REDIS_URL=rediss://user:password@your-managed-redis.example:6380

# ── Minimum for sweeps ────────────────────────────────────────────────────────
# MongoDB cloud  (configs/mongodb/example-voyage.yaml):  MONGODB_ATLAS_CLOUD_URI + VOYAGE_API_KEY
# MongoDB local  (configs/mongodb/example-local.yaml):   MONGODB_ATLAS_LOCAL_URI only
# MongoDB SIE    (configs/mongodb/example-sie.yaml):     MONGODB_ATLAS_CLOUD_URI + SIE_ENABLED=true + SIE_ENDPOINT
# Postgres cloud (configs/supabase/example-unified-retrievers.yaml):
#   STORAGE_BACKEND=postgres + POSTGRES_CLOUD_URL
# Postgres local:  STORAGE_BACKEND=postgres + POSTGRES_LOCAL_URL

SIE_ENABLED=false

# Full MongoDB checklist: docs/user-guide/mongodb-setup.md#before-you-run-a-sweep
# Full Postgres checklist: docs/user-guide/postgres-setup.md
VOYAGE_API_KEY=your_voyage_api_key_here
# Voyage rate limits — free tier defaults below; override for Tier 1 (Voyage sweep)
VOYAGE_RPM_LIMIT=3
VOYAGE_TPM_LIMIT=10000

# Voyage rate limits — Tier 1
# VOYAGE_RPM_LIMIT=2000
# VOYAGE_TPM_LIMIT=16000000

# ── SIE (opt-in — not a vector DB; single endpoint var for both remote and local) ───
# SIE is an embedding inference engine, not a storage backend — it uses one endpoint
# variable regardless of whether it is remote or self-hosted.
#
# Three server vars:
#   SIE_ENABLED   = master on/off (true = use SIE provider)
#   SIE_ENDPOINT  = where to connect (remote gateway URL or localhost:8720 for Docker)
#   SIE_API_KEY   = Bearer auth when gateway requires it (usually unset for local Docker)
# HF_TOKEN is Docker-container only (model downloads) — not a server routing var.
#
# ── Remote gateway (recommended — no local Docker) ────────────────────────────
#   SIE_ENABLED=true
#   SIE_ENDPOINT=https://your-sie-gateway.example.com
#   SIE_API_KEY=your_gateway_token
#
# ── Self-hosted Docker (only when you have no remote gateway) ─────────────────
#   SIE_ENABLED=true
#   SIE_ENDPOINT=http://localhost:8720
#   When server runs in Docker and SIE on the host:
#   SIE_ENDPOINT=http://host.docker.internal:8720
#   SIE_API_KEY=                    # usually empty for local Docker
#   HF_TOKEN=hf_...                 # HuggingFace token — Docker container only
#
# SIE_ENABLED=false
# SIE_ENDPOINT=http://localhost:8720
# SIE_API_KEY=
HF_TOKEN=your_huggingface_token_here   # Docker path only — not used by server for remote gateway

# ── Port reference (static — chosen to avoid common conflicts) ───────────────
# SERVER_URL=http://localhost:8001   # FastAPI backend (8001 — uncommon, not a framework default)
# SIE host port 8720 — avoids widely-used 8080; dashboard on :5374 (not Vite 5173)
# Aim UI: ./scripts/aim-ui.sh → http://localhost:43800 (repo: ./.aim, Docker-only UI)
# AIM_REPO=.aim                       # optional; Docker sets /app/.aim automatically

# ── Docker Compose (optional — see docs/plan/slices/03-platform/SLICE-14-DOCKER-COMPOSE.md) ───
# COMPOSE_PROJECT_NAME=rag-params-finder
# SERVER_CONTAINER_NAME=rag-params-finder-server
# FRONTEND_CONTAINER_NAME=rag-params-finder-frontend
# HF_HOME=/root/.cache/huggingface

# Optional — echoed in experiment metadata / dashboard ("Recover on Boot").
RECOVER_ON_BOOT=false

# Tiebreaker metric for ranking configs when multiple achieve same max score.
# Options: "query_avg" (default, recommended) or "chunk_avg" (legacy).
# TIEBREAKER_METRIC=query_avg

# ── CORS Configuration (ADVANCED — for production deployment) ────────────────
# Comma-separated list of allowed origins. Defaults work for local development.
# Uncomment and customize for production deployment only.
# CORS_ORIGINS=http://localhost:5374,http://127.0.0.1:5374,http://localhost:3000
# CORS_ALLOW_LOCALHOST_ORIGIN_REGEX=true  # Auto-allow localhost on any port (dev-friendly)

# Doubleword API key
DOUBLEWORD_API_KEY=""
