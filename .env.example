# ── Server ────────────────────────────────────────────────────────────────────
SERVER_URL=http://localhost:8001

# ── Storage backend: MongoDB (default) or Postgres/pgvector ───────────────────
# STORAGE_BACKEND selects which adapter the server uses.
# STORAGE_BACKEND=mongo

# ── MongoDB — Atlas Cloud (default) or Atlas Local Docker ─────────────────────
# Atlas Cloud: replace the placeholder with your connection string.
# Atlas Local: ./start-services.sh --local supplies the container URI internally.
# Set the local URI for the host CLI after --local:
#   MONGODB_URI=mongodb://localhost:27017/rag_params_finder?directConnection=true
# See docs/user-guide/mongodb-setup.md
MONGODB_URI=your_mongodb_atlas_uri_here

# Optional — auto-detect cluster storage quota for the dashboard (Atlas Admin API).
# Without these, set MONGODB_STORAGE_LIMIT_MB manually or quota UI stays hidden.
# ATLAS_PUBLIC_KEY=
# ATLAS_PRIVATE_KEY=
# ATLAS_GROUP_ID=                         # 24-char project ID from Atlas URL
# ATLAS_CLUSTER_NAME=                     # omit to parse from MONGODB_URI host
# MONGODB_STORAGE_LIMIT_MB=512            # manual override (MB); skips API lookup

# ── Postgres / pgvector (Supabase stand-in or hosted) ─────────────────────────
# Local: ./start-services.sh --postgres
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql://rag:rag@localhost:5433/rag_params_finder
# Compose service credentials (optional overrides for docker-compose.yml):
# POSTGRES_USER=rag
# POSTGRES_PASSWORD=rag
# POSTGRES_DB=rag_params_finder
#
# Supabase (hosted — Slice 37). TLS is applied automatically for *.supabase.co:
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
# See docs/user-guide/postgres-setup.md

# ── Minimum for sweeps ────────────────────────────────────────────────────────
# Mongo local  (configs/mongodb/example-local.yaml):   MONGODB_URI only
# Mongo voyage (configs/mongodb/example-voyage.yaml):  MONGODB_URI + VOYAGE_API_KEY + Tier 1 limits
# Mongo SIE    (configs/mongodb/example-sie.yaml):     MONGODB_URI + SIE_ENABLED=true + SIE_ENDPOINT
# Postgres local (configs/supabase/example-local.yaml): STORAGE_BACKEND=postgres + DATABASE_URL

SIE_ENABLED=false

# Full Mongo checklist: docs/user-guide/mongodb-setup.md#before-you-run-a-sweep
# Full Postgres checklist: docs/user-guide/postgres-setup.md
VOYAGE_API_KEY=your_voyage_api_key_here
# Voyage rate limits — free tier defaults below; override for Tier 1 (Voyage sweep)
VOYAGE_RPM_LIMIT=3
VOYAGE_TPM_LIMIT=10000

# Voyage rate limits - Tier 1
# VOYAGE_RPM_LIMIT=2000
# VOYAGE_TPM_LIMIT=16000000

# ── SIE (opt-in — not started by ./start-services.sh) ────────────────────────
# Three server vars — same for remote gateway AND local Docker:
#   SIE_ENABLED   = master on/off (true = use SIE provider)
#   SIE_ENDPOINT  = where to connect (URL — remote or localhost:8720)
#   SIE_API_KEY   = Bearer auth when gateway requires it (usually unset for local Docker)
# HF_TOKEN below is Docker-container only (model downloads) — not a server routing var.
#
# Default off: Docker stack and local dev work without SIE.
# Enable when using configs/mongodb/example-sie.yaml (or configs/supabase twin),
# provider: sie, or POST /api/v1/sweep.
#
# ── Path A: Remote gateway (recommended — NO local Docker) ─────────────────────
# If you have a hosted SIE endpoint, set these three and skip Docker entirely:
#   SIE_ENABLED=true
#   SIE_ENDPOINT=https://your-sie-gateway.example.com
#   SIE_API_KEY=your_gateway_token
#
# ── Path B: Self-hosted Docker (only when you have no remote gateway) ────────
# Run the SIE container locally — see docs/user-guide/sie-setup.md § Self-hosted Docker.
#   SIE_ENABLED=true
#   SIE_ENDPOINT=http://localhost:8720
#   When server runs in Docker and SIE on the host:
#   SIE_ENDPOINT=http://host.docker.internal:8720
#   SIE_API_KEY=                    # usually empty for local Docker
#   HF_TOKEN=hf_...                 # HuggingFace token — Docker container only (model downloads)
#
# SIE_ENABLED=false
# SIE_ENDPOINT=http://localhost:8720
# SIE_ENDPOINT=https://your-sie-gateway.example.com
# SIE_API_KEY=
HF_TOKEN=your_huggingface_token_here   # Docker path only — not used by server for remote gateway

# ── Port reference (static — chosen to avoid common conflicts) ───────────────
# SERVER_URL=http://localhost:8001   # FastAPI backend (8001 — uncommon, not a framework default)
# SIE host port 8720 — avoids widely-used 8080; dashboard on :5374 (not Vite 5173)
# Aim UI: ./scripts/aim-ui.sh → http://localhost:43800 (repo: ./.aim, Docker-only UI)
# AIM_REPO=.aim                       # optional; Docker sets /app/.aim automatically

# ── Docker Compose (optional — see docs/plan/slices/SLICE-14-DOCKER-COMPOSE.md) ───
# COMPOSE_PROJECT_NAME=rag-params-finder
# SERVER_CONTAINER_NAME=rag-params-finder-server
# FRONTEND_CONTAINER_NAME=rag-params-finder-frontend
# HF_HOME=/root/.cache/huggingface

# Optional — echoed in experiment metadata / dashboard ("Recover on Boot").
# Boot-time auto-retry is not implemented yet. Planned semantics (Slice 10):
#   docs/plan/slices/SLICE-10-RUN-RECOVERY.md — INTERRUPTED runs only on boot, not all FAILED.
RECOVER_ON_BOOT=false

# Tiebreaker metric for ranking configs when multiple achieve same max score.
# Options: "query_avg" (default, recommended) or "chunk_avg" (legacy).
# query_avg = weighted per-query average (each query contributes equally).
# chunk_avg = unweighted chunk-level average (backward compatibility only).
# TIEBREAKER_METRIC=query_avg

# ── CORS Configuration (ADVANCED — for production deployment) ────────────────
# Comma-separated list of allowed origins. Defaults work for local development.
# Uncomment and customize for production deployment only.
# CORS_ORIGINS=http://localhost:5374,http://127.0.0.1:5374,http://localhost:3000
# CORS_ALLOW_LOCALHOST_ORIGIN_REGEX=true  # Auto-allow localhost on any port (dev-friendly)
